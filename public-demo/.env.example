DF_SECRET_KEY_ATTR=GENERATE_DF_SECRET_KEY_ATTR
DF_SECRET_KEY_DEVISE=GENERATE_DF_SECRET_KEY_DEVISE
DF_ENCRYPTION_PRIMARY_KEY=GENERATE_DF_ENCRYPTION_PRIMARY_KEY
DF_ENCRYPTION_DETERMINISTIC_KEY=GENERATE_DF_ENCRYPTION_DETERMINISTIC_KEY
DF_ENCRYPTION_KEY_DERIVATION_SALT=GENERATE_DF_ENCRYPTION_KEY_DERIVATION_SALT
DOUBTFIRE_VAPID_PUBLIC_KEY=GENERATE_DOUBTFIRE_VAPID_PUBLIC_KEY
DOUBTFIRE_VAPID_PRIVATE_KEY=GENERATE_DOUBTFIRE_VAPID_PRIVATE_KEY
