server_tokens off;

# SCORM and calendar URLs contain bearer credentials. Do not log their paths.
map $uri $demo_access_loggable {
  default 1;
  ~^/api/(scorm|webcal)(?:/|$) 0;
}

server {
  listen 80 default_server;
  server_name ${PUBLIC_HOST} localhost 127.0.0.1;
  access_log /var/log/nginx/access.log main if=$demo_access_loggable;
  client_max_body_size 95m;
  error_page 413 = @upload_too_large;

  location @upload_too_large {
    default_type application/json;
    return 413 '{"error":"This demo accepts upload requests up to 95 MB. Try a smaller file.","code":"request_too_large"}';
  }

  # The outer tunnel provides public HTTPS. Its only origin is this private
  # container; the host binding is loopback for setup and local checks.
  resolver 127.0.0.11 valid=10s ipv6=off;
  set $api_upstream apiserver:3000;
  set $web_upstream webserver:80;
  proxy_set_header Host ${PUBLIC_HOST};
  proxy_set_header X-Forwarded-Proto https;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_http_version 1.1;
  proxy_read_timeout 120s;

  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy no-referrer always;
  add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
  # Match the web policy while permitting its loopback setup view via 'self'.
  proxy_hide_header Content-Security-Policy;
  add_header Content-Security-Policy "default-src 'self' https: 'unsafe-inline' 'unsafe-eval' blob: data: ws:; worker-src 'self' blob:; child-src 'self' blob:" always;

  gzip on;
  gzip_vary on;
  gzip_proxied any;
  gzip_min_length 1024;
  gzip_types application/json;

  location = /healthz {
    access_log off;
    proxy_pass http://$api_upstream/readiness;
  }

  location = /healthz/web {
    access_log off;
    proxy_pass http://$web_upstream/index.html;
  }

  location ~ ^/lti/api(?:/|$) { return 404; }
  location ~ ^/api(?:/|$) { proxy_pass http://$api_upstream; }
  location / { proxy_pass http://$web_upstream; }
}
